#!/bin/sh
# Create the Noah auth Secret in the workload namespace if it does not exist.
#
# Usage: create-auth-secret <kube-context> <namespace> <secret-name>
#
# The pass4SymmKey is generated locally and never written to the repository.
# An existing Secret is left alone so the key stays stable across reruns:
# rotating it under running pods breaks their HMAC calls to Noah.

set -eu

kube_context=${1:?kube context is required}
namespace=${2:?namespace is required}
secret_name=${3:?secret name is required}

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

for command_name in kubectl openssl; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "$command_name is required but was not found on PATH."
done

if kubectl --context "$kube_context" --namespace "$namespace" \
    get secret "$secret_name" >/dev/null 2>&1; then
    printf 'Secret %s already exists in %s.\n' "$secret_name" "$namespace"
    exit 0
fi

# LC_ALL=C keeps tr byte-oriented; a UTF-8 locale makes it reject the input.
pass4symmkey=$(openssl rand -base64 24 | LC_ALL=C tr -d '\n')

# Piping the manifest avoids the key appearing in the process list, where
# --from-literal would expose it to any local user running ps.
printf '%s\n' \
    'apiVersion: v1' \
    'kind: Secret' \
    'metadata:' \
    "  name: $secret_name" \
    'type: Opaque' \
    'stringData:' \
    "  pass4SymmKey: $pass4symmkey" |
    kubectl --context "$kube_context" --namespace "$namespace" apply -f - >/dev/null

printf 'Created Secret %s in %s.\n' "$secret_name" "$namespace"
