#!/bin/sh
# Give every Splunk pod in the namespace the same splunk.secret.
#
# Usage: create-splunk-secret <kube-context> <namespace>
#
# The operator passes splunk_secret from the namespace-scoped Secret to every
# pod, and Splunk-Ansible writes it before anything is encrypted. Without it
# each pod generates its own splunk.secret, and an SHC member that later joins
# a different captain re-encrypts server.conf at runtime; until splunkd
# restarts, its search processes cannot parse [noahService]/pass4SymmKey.
#
# The value must exist before the first Splunk pod starts. Adding or changing
# it afterwards rotates splunk.secret under existing $8$ values, so a Secret
# that predates this script is only updated while no Splunk pods exist.

set -eu

kube_context=${1:?kube context is required}
namespace=${2:?namespace is required}
secret_name="splunk-${namespace}-secret"

fail() {
    printf '%s\n' "$*" >&2
    exit 1
}

for command_name in kubectl openssl; do
    command -v "$command_name" >/dev/null 2>&1 ||
        fail "$command_name is required but was not found on PATH."
done

kube() {
    kubectl --context "$kube_context" --namespace "$namespace" "$@"
}

# Splunk's own splunk.secret is 254 characters. Base64 output keeps the value
# safe inside the double-quoted default.yml the operator renders.
# LC_ALL=C keeps tr byte-oriented; a UTF-8 locale makes it reject the input.
splunk_secret=$(openssl rand -base64 192 | LC_ALL=C tr -d '\n' | cut -c1-254)

# Only a real NotFound may lead to creation: an auth or network error must
# stop here rather than be mistaken for a missing Secret.
existing=$(kube get secret "$secret_name" --ignore-not-found -o name) ||
    fail "Could not read Secret $secret_name in $namespace."

if [ -z "$existing" ]; then
    # Piping the manifest keeps the value out of the process list. create
    # (not apply) refuses to merge into a Secret that appeared meanwhile.
    # The operator adds its remaining tokens to an existing Secret.
    printf '%s\n' \
        'apiVersion: v1' \
        'kind: Secret' \
        'metadata:' \
        "  name: $secret_name" \
        'type: Opaque' \
        'stringData:' \
        "  splunk_secret: \"$splunk_secret\"" |
        kube create -f - >/dev/null
    printf 'Created Secret %s with a shared splunk_secret in %s.\n' "$secret_name" "$namespace"
    exit 0
fi

current=$(kube get secret "$secret_name" -o jsonpath='{.data.splunk_secret}') ||
    fail "Could not read Secret $secret_name in $namespace."
if [ -n "$current" ]; then
    printf 'Secret %s already has a splunk_secret.\n' "$secret_name"
    exit 0
fi

statefulsets=$(kube get statefulsets -o name) ||
    fail "Could not list StatefulSets in $namespace."
if printf '%s\n' "$statefulsets" | grep -q '^statefulset.apps/splunk-'; then
    printf '%s\n' \
        "WARNING: $secret_name has no splunk_secret, but Splunk pods already exist in $namespace." \
        'Leaving it unchanged; adding it now would rotate splunk.secret under existing encrypted values.' \
        'Use a fresh deployment to get a shared splunk.secret.' >&2
    exit 0
fi

printf '{"stringData":{"splunk_secret":"%s"}}\n' "$splunk_secret" |
    kube patch secret "$secret_name" --type merge --patch-file /dev/stdin >/dev/null
printf 'Added a shared splunk_secret to Secret %s in %s.\n' "$secret_name" "$namespace"
