# Example environment configuration for local development and integration tests.
#
# Copy this file to .env.local (gitignored) and fill in real values:
#     cp .env.example .env.local
#
# Do NOT put secrets in .env (that file is committed and only holds tool/version
# pins). Credentials belong in .env.local, which is ignored by git.
#
# See docs/develop/DevelopmentSetup.md and docs/develop/IntegrationTesting.md
# for full descriptions of each variable.

# --- Operator deployment ---
NAMESPACE=splunk-operator                 # Target namespace for the operator
WATCH_NAMESPACE=""                        # Empty = watch all namespaces (cluster-wide)
ENVIRONMENT=default                       # Deployment environment (kustomize overlay)
SPLUNK_OPERATOR_IMAGE=splunk/splunk-operator:latest
PRIVATE_REGISTRY=localhost:5000
CLUSTER_PROVIDER=kind                     # kind | eks | azure | gcp

# --- Splunk configuration ---
# SPLUNK_ENTERPRISE_RELEASE_IMAGE is pinned in .env; override here if needed.
SPLUNK_GENERAL_TERMS=                     # Required to deploy: --accept-sgt-current-at-splunk-com

# --- AWS / S3 integration tests ---
TEST_S3_ACCESS_KEY_ID=
TEST_S3_SECRET_ACCESS_KEY=
TEST_BUCKET=
TEST_INDEXES_S3_BUCKET=

# --- Azure integration tests ---
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_CONTAINER_REGISTRY=
AZURE_CONTAINER_REGISTRY_LOGIN_SERVER=
AZURE_TEST_CONTAINER=
AZURE_INDEXES_CONTAINER=
AZURE_RESOURCE_GROUP=
AZURE_REGION=
AZURE_MANAGED_ID_ENABLED=false

# --- GCP integration tests ---
GCP_SERVICE_ACCOUNT_KEY=
GCP_STORAGE_ACCOUNT=
GCP_STORAGE_ACCOUNT_KEY=
GCP_CONTAINER_REGISTRY=
GCP_CONTAINER_REGISTRY_LOGIN_SERVER=
GCP_TEST_CONTAINER=
GCP_INDEXES_CONTAINER=
GCP_RESOURCE_GROUP=
GCP_REGION=
GCP_MANAGED_ID_ENABLED=false
