{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "mergeConfidence:all-badges"
  ],
  "labels": [
    "dependency-update"
  ],
  "major": {
    "labels": [
      "major",
      "dependency-update"
    ]
  },
  "minor": {
    "labels": [
      "minor",
      "dependency-update"
    ]
  },
  "patch": {
    "labels": [
      "patch",
      "dependency-update"
    ]
  },
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "ignorePaths": [
    ".github/**",
    "helm/charts/noah/**"
  ],
  "ignoreDeps": [
    "docker.io/splunk/universalforwarder",
    "docker.io/splunk/splunk",
    "docker.repo.splunkdev.net/noah/noah",
    "docker.repo.splunkdev.net/noah/noah-migration"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitlab-ci\\/includes\\/scs-deploy\\.yml$/",
        "/^gitlab-ci\\/scs-loki-config\\.py$/"
      ],
      "matchStrings": [
        "LOKI_DEPLOY_JOB_IMAGE='docker\\.repo\\.splunkdev\\.net/ci-cd/ci-container/python-3\\.12-bookworm:(?<currentValue>[^@'\\s]+)@sha256:(?<currentDigest>[a-f0-9]+)'",
        "\"docker\\.repo\\.splunkdev\\.net/ci-cd/ci-container/python-3\\.12-bookworm:(?<currentValue>[^\"\\s]+)\"\\s*\"@sha256:(?<currentDigest>[a-f0-9]+)\""
      ],
      "depNameTemplate": "docker.repo.splunkdev.net/ci-cd/ci-container/python-3.12-bookworm",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^test\\/testenv\\/certmanager_deps\\.go$/"
      ],
      "matchStrings": [
        "DefaultCertManagerVersion\\s*=\\s*\\\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\\\""
      ],
      "depNameTemplate": "cert-manager/cert-manager",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "assignAutomerge": true,
  "reviewers": [
    "gabrielm",
    "igorg",
    "jbuczak",
    "kkoziol",
    "mqiu",
    "patrykw",
    "qingw",
    "rlieberman",
    "vivekr"
  ],
  "packageRules": [
    {
      "description": "Group all SCS Loki deploy image references",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "docker.repo.splunkdev.net/ci-cd/ci-container/python-3.12-bookworm"
      ],
      "groupName": "SCS Loki deploy Python image"
    },
    {
      "matchPackageNames": [
        "!cert-manager",
        "!github.com/cert-manager/cert-manager",
        "!cert-manager/cert-manager"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "addLabels": [
        "dependency-update",
        "auto-merge-enabled"
      ]
    },
    {
        "matchPackageNames": ["github.com/cloudnative-pg/cloudnative-pg"],
        "separateMinorPatch": true
    },
    {
        "matchPackageNames": ["github.com/cloudnative-pg/cloudnative-pg"],
        "matchUpdateTypes": ["patch"],
        "automerge": true,
        "addLabels": [
            "dependency-update",
            "auto-merge-enabled"
        ]
    },
    {
        "matchPackageNames": ["github.com/cloudnative-pg/cloudnative-pg"],
        "matchUpdateTypes": ["major", "minor"],
        "enabled": false
    },
    {
      "description": "Group cert-manager Go, Helm, and integration-test updates",
      "matchPackageNames": [
        "cert-manager",
        "github.com/cert-manager/cert-manager",
        "cert-manager/cert-manager"
      ],
      "groupName": "cert-manager",
      "minimumGroupSize": 3,
      "automerge": false
    },
    {
      "matchPackageNames": [
        "cert-manager",
        "github.com/cert-manager/cert-manager",
        "cert-manager/cert-manager"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": false,
      "addLabels": [
        "dependency-update"
      ]
    },
    {
      "matchPackageNames": [
        "cert-manager",
        "github.com/cert-manager/cert-manager",
        "cert-manager/cert-manager"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
