@startuml
title Nightly Lane
left to right direction
skinparam Shadowing false
skinparam DefaultFontName DejaVu Sans
skinparam BackgroundColor white
skinparam ArrowColor #1d4f73
skinparam Rectangle {
  BorderColor #1d4f73
  BackgroundColor #eef6fb
  FontColor #0f172a
  RoundCorner 12
}
skinparam Note {
  BorderColor #8b6f2f
  BackgroundColor #fff7d6
  FontColor #3f3420
}

rectangle "Schedule on develop" as trigger
rectangle "Baseline\nverify, test, and helm-chart-tests" as baseline
rectangle "Build\nbuild-stage-image" as build
rectangle "Image scan\nscan-stage-image-container" as scan
rectangle "Nightly integration fanout\nall full suites in parallel" as nightly #eefbf1
rectangle "Nightly evidence\nsuite logs and junit artifacts" as evidence #f7f7ff

trigger --> baseline
baseline --> build
build --> scan
scan --> nightly
nightly --> evidence

note bottom of nightly
Nightly reuses one staged image and fans the runtime suites out
across separate EKS jobs instead of one large cluster run.
end note
@enduml
