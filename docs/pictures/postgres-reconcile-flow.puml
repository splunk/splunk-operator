@startuml
title Splunk Operator — PostgreSQL Reconcile Flows

skinparam ActivityBackgroundColor #E0F2FE
skinparam ActivityBorderColor #0284C7
skinparam ActivityDiamondBackgroundColor #FEF3C7
skinparam ActivityDiamondBorderColor #D97706
skinparam NoteBackgroundColor #F7F9FC
skinparam NoteBorderColor #64748B

|PostgresCluster controller|
start
:handleFinalizer (Delete / Retain on deletion);
note right
  Finalizer handling comes before class/config
  resolution, so a missing class or invalid
  config never blocks cleanup.
end note
if (deleted?) then (yes)
  stop
else (no)
endif
:add finalizer if absent;
:Resolve PostgresClusterClass;
:GetMergedConfig (class defaults <- cluster overrides);
:ValidateMergedConfig + ValidateCrossResource;
if (config valid?) then (no)
  :set Failed (InvalidConfiguration);
  stop
else (yes)
endif
note right
  Component pipeline (ordered):
  secret -> objectStore -> cluster
  -> managedRoles -> pooler
  -> backup -> configMap
end note
repeat :next component;
  :CheckContracts() — inputs present?;
  :Reconcile() — actuate desired state;
  :Observe() — classify componentHealth;
  if (health) then (intermediate\nPending/Provisioning/Configuring)
    :write component status;
    :requeue (early return);
    stop
  else (Ready)
  endif
repeat while (more components?) is (yes)
->no;
:all components Ready;
:project phase from CNPG cluster phase;
:set top-level phase = Ready
(only owner sets Ready);
stop

|PostgresDatabase controller|
start
:add finalizer;
:Phase ClusterValidation
— resolve clusterRef (same ns), check Ready;
if (cluster ready?) then (no)
  :ClusterReady=False, phase Pending;
  :requeue;
  stop
else (yes)
endif
:Phase CredentialProvisioning
— reconcile role Secrets (SecretsReady);
:Phase ConnectionMetadata
— reconcile ConfigMaps (ConfigMapsReady);
:Phase Roles
— gate on cluster's managed.roles status
(desired roles declared in spec, applied by the cluster controller);
if (role gate) then (conflict/failed)
  :RolesReady=False, phase Failed;
  stop
elseif (waiting for CNPG) then (pending)
  :RolesReady=False, phase Provisioning;
  :requeue;
  stop
else (ok)
endif
:Phase DatabaseProvisioning
— reconcile CNPG Database CRs (DatabasesReady);
:Phase RWRolePrivileges
— SQL grants for _rw role (PrivilegesReady);
:set phase = Ready;
stop
@enduml
